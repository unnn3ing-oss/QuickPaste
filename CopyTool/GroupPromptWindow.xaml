<Window x:Class="CopyTool.GroupPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今天值班哪些粉專？" Width="320" SizeToContent="Height" MaxHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="Assets/AppIcon.ico" Background="#ECF0F5" FontFamily="Microsoft JhengHei UI">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="今天值班哪些粉專？（可複選）" FontWeight="Bold" FontSize="15"
                   Foreground="#1C2129" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Text="不勾選直接按「顯示全部」，就會顯示所有按鈕。"
                   Foreground="#677282" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="顯示全部" Width="86" Height="30" Margin="0,0,8,0" Click="ShowAll_Click"/>
            <Button Content="確定" Width="86" Height="30" IsDefault="True" FontWeight="Bold" Click="Ok_Click"/>
        </StackPanel>

        <Border Background="White" BorderBrush="#D2DBE6" BorderThickness="1" CornerRadius="6" Padding="10,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="OptionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      FontSize="14" Margin="0,4" VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
